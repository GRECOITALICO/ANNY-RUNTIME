[Unit]
Description=ANNY Runtime Node
After=network.target

[Service]
Type=simple
User=%i
ExecStart=/usr/local/bin/anny-runtime server
Restart=on-failure
WorkingDirectory=/opt/anny-runtime
Environment=PYTHONUNBUFFERED=1
Environment=ANNY_INSTALL_MODE=system
Environment=ANNY_DATA_DIR=/var/lib/anny-runtime

[Install]
WantedBy=multi-user.target
